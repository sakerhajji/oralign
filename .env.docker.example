# Local Docker defaults. The launcher copies this file to .env on first run.
# These values are for local development only. Use strong secrets in production.

DB_USER=oralign
DB_PASSWORD=oralign_local_password
DB_NAME=oralign_db

REDIS_PASSWORD=oralign_local_redis_password

NODE_ENV=production
HTTP_PORT=3000
LOG_LEVEL=info
ENABLE_SWAGGER=true

JWT_SECRET=local-jwt-secret-change-before-production
JWT_REFRESH_SECRET=local-refresh-secret-change-before-production
JWT_RESET_SECRET=local-reset-secret-change-before-production
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Oralign
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Leave SMTP credentials empty to disable email delivery locally.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@oralign.local
