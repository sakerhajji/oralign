# ─────────────────────────────────────────────────────────────────
# Oralign — production environment
# Copy this file to `.env.production` on the VPS and fill in values.
# NEVER commit .env.production. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Compose project name (keeps containers/volumes namespaced) ────
COMPOSE_PROJECT_NAME=oralign-app

# ── Database ──────────────────────────────────────────────────────
# Postgres is bound to 127.0.0.1:5432 in production compose;
# never expose it to the public internet.
DB_USER=oralign
DB_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
DB_NAME=oralign_db

# DATABASE_URL is consumed by Prisma. Inside Docker network the
# hostname is the service name `postgres`.
DATABASE_URL=postgresql://oralign:__GENERATE_A_LONG_RANDOM_PASSWORD__@postgres:5432/oralign_db

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

# ── App runtime ───────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Public URLs (used by frontend + CORS allowlist)
FRONTEND_URL=https://oralign.com.tn
NEXT_PUBLIC_API_URL=https://api.oralign.com.tn/api
NEXT_PUBLIC_APP_NAME=Oralign
NEXT_PUBLIC_APP_URL=https://oralign.com.tn

# ── JWT — generate with: openssl rand -base64 48 ──────────────────
JWT_SECRET=__GENERATE_64+_RANDOM_CHARS__
JWT_REFRESH_SECRET=__GENERATE_64+_RANDOM_CHARS__
JWT_RESET_SECRET=__GENERATE_64+_RANDOM_CHARS__
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# ── SMTP (transactional email) ────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=__YOUR_SMTP_USER__
MAIL_PASSWORD=__YOUR_SMTP_PASSWORD__
MAIL_FROM=noreply@oralign.com.tn

# ── Storage paths on the VPS host ────────────────────────────────
# These directories are bind-mounted into the containers.
# Created by scripts/setup-vps.sh.
POSTGRES_HOST_DIR=/var/lib/oralign-app/postgres
UPLOADS_HOST_DIR=/var/lib/oralign-app/uploads
BACKUPS_HOST_DIR=/var/lib/oralign-app/backups

# ── Backup retention ──────────────────────────────────────────────
BACKUP_KEEP_LAST=14

# ── Application directory on the VPS ──────────────────────────────
APP_DIR=/opt/oralign-app
