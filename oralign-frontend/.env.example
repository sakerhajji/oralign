# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# App Configuration
NEXT_PUBLIC_APP_NAME=Oralign
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Search Console ownership token: the `content` value of the
# "HTML tag" verification method. Set it on the production deployment and
# the meta tag ships on every page, keeping the property verified across
# redeploys. Leave empty locally — nothing is emitted when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Frontend port (npm run dev / npm start). Defaults to 3001 if unset.
PORT=3001
