generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  dentist
  admin
  designer
  super_admin
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum Gender {
  male
  female
  other
}

enum OrderStatus {
  draft
  submitted
  under_review
  treatment_planning
  treatment_plan_ready
  revision_requested
  treatment_approved
  quotation_sent
  payment_plan_selected
  payment_pending
  payment_review
  paid
  fabrication
  ready_to_ship
  shipped
  finished
  canceled
  // ─── Legacy values (existing rows reference these; keep until migrated) ─
  in_review
  approved
  rejected
  cancelled
}

enum TreatmentPlanStatus {
  pending
  ready
  approved
  rejected
}

enum TreatmentMessageType {
  message
  system
  approval
  rejection
  file
  treatment_result
}

enum TreatmentAttachmentCategory {
  image
  xray
  stl
  ply
  obj
  zip
  pdf
  video
  treatment_file
  treatment_result
  container
  other
}

enum PatientStage {
  initial
  refinement
  retainer
}

enum ArchTreatment {
  upper
  lower
  both
}

enum ToothInstructionType {
  // ── Order-level (set by the doctor when creating the order) ─────
  no_attachments
  do_not_move
  no_ipr
  extract
  // ── Treatment-plan level (set by the planner) ───────────────────
  // attachment = planner placed an attachment on this tooth.
  //              Distinct from `no_attachments` which is the doctor
  //              saying "please don't use attachments here". Pink
  //              swatch in the UI.
  // ipr_value  = planner-set inter-proximal-reduction amount; the
  //              `value` column carries the mm, the `note` column
  //              carries the optional "stripping" auxiliary value.
  attachment
  ipr_value
}

enum OrderFileCategory {
  right_photo
  front_photo
  left_photo
  upper_photo
  lower_photo
  orthopantomography
  stl
  ply
  obj
  zip
  pdf
  image
  video
  other
}

// Devis / Quotation language. Drives PDF labels, header copy, footer
// legal text, and the snapshot persisted alongside each Quotation.
enum DevisLanguage {
  fr
  en
  ar
}

// Quotation lifecycle. Mirrors the existing TreatmentPlanStatus shape so
// the doctor's review UX is consistent. `canceled` is a separate terminal
// state from `rejected` — admin may CANCEL a draft/sent quote, the doctor
// REJECTS a sent quote.
enum QuotationStatus {
  draft
  sent
  approved
  rejected
  canceled
}

// ─────────────────────────────────────────
// PACKS / INSTALLMENTS / PAYMENTS
// ─────────────────────────────────────────
//
// Commercial packs are sold as fixed offerings; a Quotation snapshots
// the chosen pack + arch + price at creation time so later edits to
// the pack catalogue never mutate already-issued quotes. Installments
// are the payment schedule (money); step batches are the delivery
// schedule (aligners). Paying an installment UNLOCKS the linked
// batch — admin delivers manually. See:
//   - PaymentsService.handleSuccess (the single SUCCESS transition)
//   - InstallmentsService.configurePaymentPlan (sum + range checks)

enum ArchType {
  single_arch
  two_arches
}

enum PaymentMode {
  full_payment
  installments
}

enum QuotationPaymentStatus {
  pending
  partially_paid
  paid
  failed
  cancelled
}

enum InstallmentStatus {
  pending
  paid
  overdue
  cancelled
}

enum BatchStatus {
  locked
  unlocked
  delivered
}

enum PaymentMethod {
  card
  bank_transfer
  cash
}

// Lifecycle states for a Payment record. CARD goes pending → success
// (gateway) or pending → failed. BANK_TRANSFER goes awaiting_confirmation
// → success (admin confirm) or → rejected (admin reject). CASH goes
// straight to success (admin records).
enum PaymentRecordStatus {
  pending
  awaiting_confirmation
  success
  failed
  rejected
  cancelled
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id                  String             @id @default(uuid())
  fullName            String
  email               String             @unique
  // Unique when present. Postgres treats NULLs as distinct, so multiple
  // users may still have NO phone — only a *set* phone must be unique.
  phone               String?            @unique
  passwordHash        String

  role                UserRole           @default(dentist)
  isActive            Boolean            @default(true)

  // Email verification
  isEmailVerified          Boolean            @default(false)
  emailVerificationCode    String?
  emailVerificationExpiry  DateTime?

  // Account verification — single source of truth (drop isVerified boolean)
  verificationStatus  VerificationStatus @default(pending)

  // Brute-force protection
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?          // null = not locked
  // Email-verification brute-force protection (audit M-7) — separate
  // from sign-in so a failed OTP never locks the password login.
  failedVerificationAttempts Int         @default(0)

  // Session revocation (audit M-6). Embedded in issued access + refresh
  // tokens; bumped on password reset / change so every previously issued
  // token becomes invalid. The refresh path rejects a token whose `tv`
  // no longer matches, so a stolen/old session cannot be renewed.
  tokenVersion        Int                @default(0)

  // Profile
  avatarUrl           String?            // validated path only, no raw URLs
  country             String?            // personal country, separate from clinic
  // UI + outbound-content language ("fr" | "en"). Drives the language
  // of notifications, emails and any backend-generated copy addressed
  // to this user. Plain String (not enum) so adding a locale later is
  // a data change, not a migration. Default matches the app default.
  preferredLanguage   String             @default("en")

  // Timestamps
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?          // soft delete

  dentistProfile      DentistProfile?
  patients            Patient[]
  doctorOrders        DentalOrder[]      @relation("OrderDoctor")
  designerOrders      DentalOrder[]      @relation("OrderDesigner")
  createdTreatmentPlans TreatmentPlan[]  @relation("TreatmentPlanCreator")
  createdToothInstructions OrderToothInstruction[] @relation("ToothInstructionCreator")
  createdTreatmentPlanIprs TreatmentPlanIpr[] @relation("TreatmentPlanIprCreator")
  sentTreatmentMessages TreatmentMessage[]
  uploadedTreatmentAttachments TreatmentMessageAttachment[]
  loyaltyQuarters      LoyaltyQuarterResult[]
  createdQuotations    Quotation[]       @relation("QuotationCreatedBy")
  approvedQuotations   Quotation[]       @relation("QuotationApprovedBy")
  rejectedQuotations   Quotation[]       @relation("QuotationRejectedBy")

  // Payment + delivery audit trails — populated by PaymentsService /
  // BatchesService when an admin acts on a record.
  confirmedPayments    Payment[]         @relation("PaymentConfirmedBy")
  rejectedPayments     Payment[]         @relation("PaymentRejectedBy")
  initiatedPayments    Payment[]         @relation("PaymentInitiatedBy")
  deliveredBatches     QuoteStepBatch[]  @relation("BatchDeliveredBy")

  // In-app notifications addressed to this user. The NotificationsModule
  // owns the read-state lifecycle; the relation is here purely so we can
  // ON DELETE CASCADE clean them up when a user is hard-deleted.
  notifications        Notification[]

  // Support chat — doctors author conversations; admins assign/reply.
  // Two named relations because a User can be either side depending
  // on role. Cascade on User delete: drop the doctor's conversations
  // entirely; assigned-admin reference is SetNull so a deleted admin
  // doesn't orphan a doctor's open ticket.
  doctorSupportConversations SupportConversation[] @relation("SupportConvDoctor")
  assignedSupportConversations SupportConversation[] @relation("SupportConvAdmin")
  sentSupportMessages          SupportMessage[]    @relation("SupportMessageSender")

  // Slider media authored by this admin. SetNull on user delete keeps
  // the slide in the gallery even after the admin who uploaded it
  // is removed.
  createdSliderMedia       SliderMedia[]       @relation("SliderMediaCreatedBy")

  // Practitioner blog — posts authored by this admin + images they
  // uploaded into the blog media library. SetNull on user delete so a
  // removed admin doesn't take their published posts/images down with
  // them; the row keeps `authorName`/`createdById = null` for audit.
  blogPosts                Blog[]              @relation("BlogAuthor")
  blogImages               BlogImage[]         @relation("BlogImageCreatedBy")

  // Patient community submissions reviewed by an admin before publication.
  reviewedCommunitySubmissions CommunitySubmission[] @relation("CommunitySubmissionReviewedBy")

  // Manual/admin invoicing. All three are SetNull on the Invoice side:
  // a financial document outlives the account that issued or was billed.
  invoicesAsDoctor         Invoice[]           @relation("InvoiceDoctor")
  invoicesCreated          Invoice[]           @relation("InvoiceCreatedBy")
  invoiceAuditEntries      InvoiceAuditLog[]   @relation("InvoiceAuditActor")

  @@index([email])
  @@index([role])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([deletedAt])               // fast soft-delete filtering
  @@index([lockedUntil])             // lockout queries
}

// ─────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────

model Patient {
  id            String    @id @default(uuid())
  doctorId      String
  fullName      String
  email         String?
  phone         String?
  gender        Gender?
  dateOfBirth   DateTime?
  address       String?
  notes         String?
  profilePhotoUrl String?

  // ── Clinical conditions ───────────────────────────────────────────
  // `clinicalConditions` is a free String[] rather than a strict
  // Postgres enum so the clinic can extend the list without a Prisma
  // migration each time. The frontend constrains it to a known set of
  // labels (Crowding / Spacing / Class II Div 1 / Class II Div 2 /
  // Class III / Open bite / Anterior crossbite / Posterior crossbite /
  // Deep bite / Narrow arch / Proclination / Increased overjet /
  // Unesthetic smile / Dental shape anomaly / Other).
  //
  // `clinicalConditionsOther` carries the free-text detail the doctor
  // types when they tick "Other". It is meaningful only when "Other"
  // is in the array; the frontend hides it otherwise.
  clinicalConditions      String[]  @default([])
  clinicalConditionsOther String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // DELETION POLICY: Restrict. A dentist account that owns patients can
  // never be hard-deleted (soft-delete via User.deletedAt instead) — the
  // patient row is the root of the clinical + financial tree.
  doctor        User      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  orders        DentalOrder[]
  // Manual invoices billed to this patient (Restrict: a patient with an
  // invoice can be archived but never purged).
  invoices      Invoice[]

  @@index([doctorId])
  @@index([deletedAt])
  @@index([fullName])
  @@index([email])
  @@index([phone])
}

// ─────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────

model DentalOrder {
  id                            String                    @id @default(uuid())
  orderCode                     String                    @unique
  doctorId                      String
  patientId                     String
  assignedDesignerId            String?
  status                        OrderStatus               @default(draft)

  patientStage                  PatientStage?
  chiefComplaint                String?
  archTreatment                 ArchTreatment?
  treatBothArch                 Boolean                   @default(false)
  treatmentPlan                 String?
  dontMoveOption                String?
  apRelationship                String?
  anteroposteriorRelationship   String?
  elastics                      String?
  openBite                      String?
  midline                       String?
  ipr                           String?
  biteRamps                     String?
  // Expansion plan — encoded as a short structured string from the wizard
  // (e.g. "Both — anterior priority"). Free-text so the lab can also add
  // notes if the dentist needs to describe something atypical.
  expansion                     String?
  crossbite                     String?
  spaces                        String?
  extractions                   String?
  specialInstructions           String?
  additionalInstructions        String?
  useCbctWithScans              Boolean                   @default(false)
  wantsManufacturing            Boolean                   @default(false)
  materials                     String[]                  @default([])

  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  submittedAt                   DateTime?
  // Stamped when the doctor accepts the General Terms & Conditions on
  // submit. Submitting without accepting is rejected at the service +
  // DTO layer, so a submitted order always carries this timestamp.
  termsAcceptedAt               DateTime?
  // Set the first time an admin opens this order's detail page. Drives the
  // sidebar "new orders" badge: a submitted order counts as NEW until an
  // admin has seen it (NULL = unseen). Like an unread marker.
  adminSeenAt                   DateTime?
  deletedAt                     DateTime?

  // ── Treatment-fee gate ──────────────────────────────────────────
  // Filled the moment the clinical/professional fee is collected
  // (admin records cash/transfer or doctor pays online). The
  // treatment-plan creation flow refuses to start until this is
  // non-null AND the company setting `defaultTreatmentFee > 0`.
  // If the tenant hasn't configured a treatment fee (=0), the gate
  // is bypassed and the legacy flow keeps working as before.
  // treatmentFeeAmount snapshots the amount AT payment time so a
  // later setting change can't rewrite an already-paid order.
  treatmentFeePaidAt            DateTime?
  treatmentFeeAmount            Decimal?                  @db.Decimal(12, 3)

  // Payment method + status: reuse the same PaymentMethod and
  // PaymentRecordStatus enums the installment Payment table uses, so
  // admin payment-queue tooling can read both surfaces identically.
  // Lifecycle:
  //   • CARD   → set to (card, success) the moment the doctor "pays"
  //              and `treatmentFeePaidAt = now()`. Card collection
  //              is instant in the existing mock flow.
  //   • CASH   → admin-only path; (cash, success) recorded by admin
  //              with `treatmentFeePaidAt = now()`.
  //   • BANK_TRANSFER →
  //              doctor uploads proof → (bank_transfer,
  //              awaiting_confirmation) + proofPath set, but
  //              `treatmentFeePaidAt` stays NULL. Admin reviews the
  //              proof and confirms → status flips to `success` and
  //              `treatmentFeePaidAt` stamped.
  treatmentFeePaymentMethod     PaymentMethod?
  treatmentFeePaymentStatus     PaymentRecordStatus?
  // Relative path under uploads/ for the bank-transfer receipt.
  treatmentFeeProofPath         String?

  // Sequential treatment-fee receipt number (TF-000001) — a SEPARATE
  // sequence from the installment FAC- invoices. Allocated lazily on
  // first receipt render; admin-editable; unique so two receipts never
  // share a printed number.
  treatmentFeeInvoiceNumber     String?                   @unique

  // ── CBCT paid supplement snapshot ───────────────────────────────
  // Snapshot of CompanyBillingSettings.cbctSupplementFee taken
  // SERVER-SIDE when the doctor requests CBCT on a DRAFT order (create
  // or update while status = draft). Frozen once the order leaves
  // draft, so a later config change never rewrites the price of an
  // existing order — same idiom as treatmentFeeAmount / the pack
  // snapshot on quotes. NULL when CBCT was not requested or the
  // supplement is disabled / configured at 0.
  cbctFeeAmount                 Decimal?                  @db.Decimal(12, 3)
  cbctFeeCurrency               String?

  // Approved treatment plan reference — used by the order's lifecycle.
  approvedTreatmentPlanId       String?

  // DELETION POLICY: Restrict on both parents. Orders own numbered devis,
  // payments (invoice numbers) and treatment plans — a doctor or patient
  // hard-delete must be blocked while orders exist, never cascade into
  // the ledger. Soft-delete (deletedAt) is the normal path.
  doctor                        User                      @relation("OrderDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  patient                       Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedDesigner              User?                     @relation("OrderDesigner", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  toothInstructions             OrderToothInstruction[]
  files                         OrderFile[]
  treatmentPlans                TreatmentPlan[]
  // One active quotation per order. Cancelled quotes stay in history but
  // a fresh one can be created after cancel. The 1:1 is enforced by the
  // unique constraint on `Quotation.orderId`.
  quotation                     Quotation?
  payments                      Payment[]
  uploadSessions                UploadSession[]
  // Manual invoices attached to this order (Restrict: an order with an
  // invoice cannot be purged, only archived).
  invoices                      Invoice[]

  @@index([doctorId])
  @@index([patientId])
  @@index([assignedDesignerId])
  @@index([status])
  @@index([orderCode])
  @@index([deletedAt])
  @@index([createdAt])
}

model OrderToothInstruction {
  id             String               @id @default(uuid())
  orderId        String
  toothNumber    Int
  type           ToothInstructionType
  // Optional numeric value (e.g. IPR amount in mm for type = ipr_value)
  // and a free-text note. Both nullable so existing rows keep working.
  value          String?
  note           String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime?            @updatedAt

  order          DentalOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("ToothInstructionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orderId, toothNumber, type])
  @@index([orderId])
  @@index([toothNumber])
}

// Lifecycle of the async media-optimization pipeline. `null` on a row
// means the pipeline does not apply (e.g. PDFs, videos) or the row
// predates the pipeline and hasn't been backfilled yet — readers must
// treat null exactly like "no variants, serve the original".
enum MediaProcessingStatus {
  pending
  processing
  completed
  failed
}

model OrderFile {
  id             String               @id @default(uuid())
  orderId        String
  category       OrderFileCategory
  originalName   String
  fileName       String
  relativePath   String
  mimeType       String
  size           Int
  createdAt      DateTime             @default(now())
  deletedAt      DateTime?

  // ── Media-optimization pipeline ──────────────────────────────────
  // Clean human-readable name built from patient + category + sequence
  // (e.g. "Marie-Dupont_front-photo_003.jpg"). The original client
  // filename is preserved above in `originalName`; this one is what the
  // file is stored and downloaded as.
  generatedName    String?
  // Per (order, category) upload sequence — drives display order and
  // the NNN suffix in generatedName. Legacy rows keep 0 and fall back
  // to createdAt ordering.
  orderIndex       Int                  @default(0)
  // Intrinsic pixel size of the ORIGINAL image (null for non-images).
  width            Int?
  height           Int?
  processingStatus MediaProcessingStatus?
  // Variant map written by the pipeline:
  //   { thumb|md|lg|avif|model: { path, width?, height?, sizeBytes, format } }
  // Paths are uploads-root-relative and NEVER exposed raw over the API —
  // the DTO mapper strips `path` and clients fetch via ?variant=<name>.
  variants         Json?
  // Type-specific safe metadata: zip → { entryCount, topLevelEntries,
  // totalUncompressedBytes, suspicious }, stl → { format, triangleCount,
  // vertexCount, bbox }.
  mediaMetadata    Json?
  processedAt      DateTime?

  order          DentalOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([category])
  @@index([deletedAt])
  @@index([processingStatus])
}

// ── Chunked / resumable uploads ─────────────────────────────────────
// One row per in-flight large upload (CBCT ZIP bundles). Chunks land as
// `part-<index>` files under uploads/tmp/chunked/<sessionId>/ and the
// row tracks which indexes arrived, so an interrupted upload resumes
// instead of restarting. On completion the parts are STREAMED into the
// final file (never buffered in RAM), scanned, registered as a normal
// OrderFile and the session is deleted. Stale sessions (updatedAt older
// than the TTL) are swept together with their part directories by
// UploadCleanupService.
enum UploadSessionStatus {
  active
  assembling
  completed
  failed
}

model UploadSession {
  id             String              @id @default(uuid())
  orderId        String
  uploaderId     String
  category       OrderFileCategory
  originalName   String
  mimeType       String?
  totalBytes     BigInt
  chunkSize      Int
  totalChunks    Int
  // Chunk indexes received so far (small: 1 GB / 8 MiB = 128 entries).
  receivedChunks Int[]               @default([])
  status         UploadSessionStatus @default(active)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order          DentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, updatedAt])
}

// ─────────────────────────────────────────
// TREATMENT PLAN
// ─────────────────────────────────────────

model TreatmentPlan {
  id                          String              @id @default(uuid())
  orderId                     String
  // Auto-incremented per order (Treatment Plan 1, 2, 3 …).
  version                     Int
  name                        String
  status                      TreatmentPlanStatus @default(pending)

  // Treatment web viewer URL (3D viewer / aligner setup link).
  resultViewUrl               String?

  // Optional bundled deliverable (e.g. a zip the designer attaches).
  filePath                    String?

  // Orthodontic tooth movement table — uploaded image metadata.
  movementTableImagePath      String?
  movementTableImageName      String?
  movementTableImageMimeType  String?
  movementTableImageSizeBytes Int?

  // ── Dental treatment table (a.k.a. "Traitement dentaire") ───────────
  // Second image artefact the planner attaches alongside the movement
  // table. Holds the per-tooth restorative / endo / extraction plan —
  // a separate clinical document from the orthodontic movement table
  // above. Same upload contract (PNG / JPEG / WebP, ≤10 MB); kept in
  // its own four columns so neither image overwrites the other.
  dentalTreatmentTableImagePath      String?
  dentalTreatmentTableImageName      String?
  dentalTreatmentTableImageMimeType  String?
  dentalTreatmentTableImageSizeBytes Int?

  totalUpperAligners          Int?
  totalLowerAligners          Int?
  issuedUpperAligners         Int?
  issuedLowerAligners         Int?

  createdById                 String?
  createdByName               String?             // actor snapshot (survives account deletion)
  approvedAt                  DateTime?
  rejectedAt                  DateTime?

  // Public viewer access — token grants read-only access to a slim subset.
  publicToken                 String?             @unique
  publicExpiresAt             DateTime?

  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  deletedAt                   DateTime?

  // DELETION POLICY: Restrict — the plan IS the clinical record. An order
  // can only be permanently deleted while it has no plan (see
  // OrderService.permanentDeleteOrder dependency check).
  order                       DentalOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Actor reference, not ownership: SetNull so hard-deleting a staff
  // account never removes plans on other doctors' orders. createdByName
  // is snapshotted at creation so the audit trail survives the SetNull.
  createdBy                   User?               @relation("TreatmentPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages                    TreatmentMessage[]
  // Treatment-level IPR / stripping entries — between-tooth contacts.
  // Lives in its own table so it can't collide with the doctor's
  // order-level OrderToothInstruction rows (those are anchored on a
  // single tooth, IPR is between two). See the TreatmentPlanIpr model
  // below for the contract.
  iprEntries                  TreatmentPlanIpr[]

  @@unique([orderId, version])
  @@index([orderId])
  @@index([status])
  @@index([publicToken])
  @@index([deletedAt])
}

/**
 * Treatment-level IPR (Inter-Proximal Reduction) / stripping entry.
 *
 * Architectural reason this exists as a SEPARATE table instead of being
 * folded into OrderToothInstruction:
 *
 *   • OrderToothInstruction stores per-TOOTH facts the doctor wrote on
 *     the order (no_attachments, do_not_move, no_ipr, extract) plus the
 *     planner's per-tooth attachment marker. Its unique constraint
 *     (orderId, toothNumber, type) reflects that one-tooth identity.
 *
 *   • IPR is INHERENTLY a CONTACT property — it exists between two
 *     adjacent teeth and carries a measurement (mm) plus an optional
 *     stripping auxiliary value. Pretending it lives on one tooth
 *     caused: (a) the legacy single-tooth model was confusing to the
 *     dental team, (b) the unique constraint kept conflicting with the
 *     four order-level types under concurrent writes (P2002).
 *
 * The new model is keyed by (treatmentPlanId, fromTooth, toTooth).
 * Writes flow through `prisma.treatmentPlanIpr.upsert`, so re-saving
 * the same contact is idempotent — no createMany, no race, no P2002.
 *
 * The data is scoped to the TREATMENT PLAN (not the order) so each
 * plan version owns its own IPR map. A new plan starts with no IPR
 * unless the planner duplicates from the previous version explicitly.
 */
model TreatmentPlanIpr {
  id              String        @id @default(uuid())
  treatmentPlanId String

  // FDI tooth numbers identifying the contact. The render order in the
  // odontogram uses the within-half "previous → current" convention
  // (11→12, 21→22, 41→42, 31→32, …). For the two midline contacts the
  // canonical pairs are (11, 21) upper and (41, 31) lower.
  fromTooth       Int
  toTooth         Int

  // IPR amount in mm. Stored as a string so trailing zeros (`"0.20"`)
  // round-trip exactly through forms — the dental team expects to see
  // their input back unchanged.
  value           String

  // Optional auxiliary value the dental team calls "stripping" — its
  // semantics vary by clinic (aligner step #, side, raw count). Free
  // text so we don't lock the protocol prematurely.
  note            String?

  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  createdBy       User?         @relation("TreatmentPlanIprCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Per-plan uniqueness on the contact-point — duplicate writes upsert.
  @@unique([treatmentPlanId, fromTooth, toTooth])
  @@index([treatmentPlanId])
}

model TreatmentMessage {
  id              String                       @id @default(uuid())
  treatmentPlanId String
  senderId        String?
  // Actor snapshot: the thread must still read correctly after the
  // sender's account is hard-deleted (senderId -> SetNull).
  senderName      String?
  senderRole      UserRole?
  message         String?
  type            TreatmentMessageType         @default(message)

  createdAt       DateTime                     @default(now())
  updatedAt       DateTime?                    @updatedAt
  deletedAt       DateTime?

  treatmentPlan   TreatmentPlan                @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  sender          User?                        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments     TreatmentMessageAttachment[]

  @@index([treatmentPlanId])
  @@index([senderId])
  @@index([deletedAt])
  @@index([createdAt])
}

model TreatmentMessageAttachment {
  id            String                       @id @default(uuid())
  messageId     String
  uploadedById  String?
  fileName      String
  filePath      String                       // relative path under uploads/
  mimeType      String?
  sizeBytes     Int?
  category      TreatmentAttachmentCategory  @default(other)

  // ── Media-optimization pipeline (same contract as OrderFile) ─────
  width            Int?
  height           Int?
  processingStatus MediaProcessingStatus?
  variants         Json?
  mediaMetadata    Json?

  createdAt     DateTime                     @default(now())
  deletedAt     DateTime?

  message       TreatmentMessage             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Uploader is an actor ref, not an owner: a treatment_result deliverable
  // must not vanish because a designer account was deleted.
  uploadedBy    User?                        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([category])
  @@index([deletedAt])
}

// ─────────────────────────────────────────
// DENTIST PROFILE
// ─────────────────────────────────────────

model DentistProfile {
  id             String         @id @default(uuid())
  userId         String         @unique

  clinicName     String
  clinicAddress  String?
  city           String?
  country        String?        // clinic country, separate from user personal country

  // Geo — reconstruct Maps URL at render time from these
  latitude       Float?
  longitude      Float?

  clinicPhone    String?
  clinicEmail    String?        @unique   // one email per clinic

  // Doctor's clinic tax registration number ("Matricule fiscal"). This
  // is the DOCTOR/clinic tax id shown in the invoice "Billed to" block —
  // distinct from CompanyBillingSettings.taxRegistrationNumber, which is
  // the Oralign (company) header tax id.
  taxId          String?

  description    String?
  logoUrl        String?        // validated path only, no raw URLs

  // Public directory ("Trouver un praticien"): the practitioner's specialty
  // shown on the finder, and whether the clinic appears in the public list.
  // Opt-OUT — approved, active partner clinics are listed by default and can
  // hide themselves from the clinic settings. (Private data — tax id, clinic
  // email — is never exposed regardless of this flag.)
  specialty        String?
  isListedPublicly Boolean      @default(true)

  // Timestamps + soft delete (mirrors User)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours   WorkingHours[]
  appointments   Appointment[]

  @@index([city])
  @@index([country])
  @@index([latitude, longitude])   // geo proximity search
  @@index([isListedPublicly])      // public directory filter
  @@index([deletedAt])
}

// ─────────────────────────────────────────
// WORKING HOURS  
// ─────────────────────────────────────────

model WorkingHours {
  id               String         @id @default(uuid())
  dentistProfileId String

  dayOfWeek        DayOfWeek
  openTime         String         // "09:00" — store as HH:mm
  closeTime        String         // "17:00"
  isClosed         Boolean        @default(false)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  dentistProfile   DentistProfile @relation(fields: [dentistProfileId], references: [id], onDelete: Cascade)

  // One row per day per clinic
  @@unique([dentistProfileId, dayOfWeek])
  @@index([dentistProfileId])
}

// ─────────────────────────────────────────
// APPOINTMENTS (public "Trouver un praticien" booking)
// ─────────────────────────────────────────

enum AppointmentStatus {
  pending
  accepted
  declined
  cancelled
  expired
}

/// Public appointment request from a patient to a listed practitioner.
/// The patient is NOT an app User — this is a public lead. The practitioner
/// accepts / declines via a tokenized link in their notification email
/// (unauthenticated action); the patient then gets a final-status email.
model Appointment {
  id               String            @id @default(uuid())
  dentistProfileId String

  // Patient (public lead — not a User row)
  patientName      String
  patientEmail     String
  patientPhone     String?
  patientAddress   String?
  message          String?

  // Concrete slot chosen from the availability grid (start of the visit).
  requestedAt      DateTime
  status           AppointmentStatus @default(pending)

  // Opaque token embedded in the practitioner's accept / decline email
  // links. Once `status` leaves `pending` the links become inert.
  actionToken      String            @unique @default(uuid())
  respondedAt      DateTime?

  // Language the patient used on the site, so their emails match.
  patientLang      String            @default("fr")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  dentistProfile   DentistProfile    @relation(fields: [dentistProfileId], references: [id], onDelete: Cascade)

  @@index([dentistProfileId, requestedAt])
  @@index([status])
  @@index([actionToken])
}

// ─────────────────────────────────────────
// COMPANY BILLING SETTINGS
// ─────────────────────────────────────────
//
// Singleton-style configuration row that drives the Quote PDF header,
// footer, bank info, and the auto-incremented quotation number. There
// can be many rows in theory, but only ONE is active at a time
// (filtered by `isActive = true`). Admin upserts the active row from the
// settings UI.
//
// JSONB columns store per-language text + bank account info so the admin
// can edit them from a single form without schema changes. Examples:
//
//   legalTextTranslations:
//     { "fr": "Texte légal…", "en": "Legal text…", "ar": "النص…" }
//   footerTextTranslations:
//     { "fr": "Merci…",       "en": "Thank you…", "ar": "شكراً…" }
//   bankDetails:
//     { "bankName": "BIAT", "accountName": "Oralign SARL",
//       "rib": "…", "iban": "TN59…", "swift": "BIATTNTT" }
//
// Each generated Quotation snapshots these values into `companySnapshot`
// so old quotes stay correct after admin edits the settings later.
model CompanyBillingSettings {
  id                      String        @id @default(uuid())

  companyName             String
  companyLogoPath         String?       // relative path under uploads/
  companyAddress          String?
  companyCity             String?
  companyCountry          String?
  companyPhone            String?
  companyEmail            String?
  taxRegistrationNumber   String?

  // ── Legal identity (Tunisian "Mentions légales" requirements) ──────────
  // These back the public compliance pages (mentions légales, conditions
  // de vente, etc.) so the merchant's legal identity is admin-editable and
  // never hardcoded in the frontend. All nullable → additive, db-push-safe.
  tradeName               String?       // Nom commercial (if different from companyName)
  legalForm               String?       // Forme juridique — SUARL / SARL / personne physique…
  registreDeCommerce      String?       // Registre de commerce (RC)
  hostingProvider         String?       // Hébergeur — provider name
  hostingProviderUrl      String?       // Hébergeur — provider website
  websiteDomain           String?       // e.g. oralign.com.tn

  defaultTvaRate          Float         @default(19)
  defaultCurrency         String        @default("TND")

  // Default professional / treatment fee. The QuotationService prefills
  // `Quotation.treatmentFees` from this when a new quote is created so
  // the admin no longer has to retype the clinical fee every time. The
  // admin can still override per quote (e.g. for a discount or a free
  // first quote). Decimal(12,3) matches PackPrice so both fee lines
  // round identically when computing TTC. Cast back to Float at the
  // DTO boundary — the Quotation row itself still stores Float fees
  // until a wider migration moves them to Decimal across the board.
  defaultTreatmentFee     Decimal       @default(0) @db.Decimal(12, 3)

  // "Droit de timbre" — the Tunisian fiscal stamp duty (typically
  // 1.000 TND) added to the INVOICE total. Configured by the admin in
  // the billing settings. Decimal(12,3) mirrors defaultTreatmentFee so
  // it rounds identically; cast back to Number at the DTO boundary.
  stampDuty               Decimal       @default(1) @db.Decimal(12, 3)

  // ── CBCT paid supplement ─────────────────────────────────────────
  // When enabled with a fee > 0, requesting CBCT on a new order adds
  // this supplement to the professional fee. The amount is snapshotted
  // onto the order (DentalOrder.cbctFeeAmount) at request time, so
  // editing it here only affects NEW orders. Currency follows
  // defaultCurrency — the merchant bills in a single currency.
  cbctSupplementEnabled   Boolean       @default(false)
  cbctSupplementFee       Decimal       @default(0) @db.Decimal(12, 3)

  // ── Beyond-the-pack price list (grille 2026) ─────────────────────
  // Informational tariffs the admin edits without code: extra
  // refinements, replacement aligner, end-of-treatment retainers.
  // Like the CBCT supplement they follow defaultCurrency; a value of
  // 0 simply hides the line on doctor-facing surfaces.
  refinementTwoArchesFee   Decimal      @default(0) @db.Decimal(12, 3)
  refinementSingleArchFee  Decimal      @default(0) @db.Decimal(12, 3)
  replacementAlignerFee    Decimal      @default(0) @db.Decimal(12, 3)
  retainersFee             Decimal      @default(0) @db.Decimal(12, 3)

  // Master switch of the quarterly loyalty program. Off = no discount
  // is ever applied at pack-attach time; history stays intact.
  loyaltyEnabled           Boolean      @default(true)

  // Devis numbering. Incremented inside a transaction when each quote
  // is first assigned a number, so two concurrent quote-creations can't
  // collide on the same DEV-XXXXXX value.
  devisPrefix             String        @default("DEV")
  devisNextNumber         Int           @default(1)

  // Invoice/receipt numbering. Same transactional-counter scheme as the
  // devis number above — sequential FAC-XXXXXX, legally gapless.
  invoicePrefix           String        @default("FAC")
  invoiceNextNumber       Int           @default(1)

  // Treatment-fee receipt numbering — a SEPARATE sequence from the
  // installment invoice counter above (TF-XXXXXX).
  treatmentFeeInvoicePrefix     String  @default("TF")
  treatmentFeeInvoiceNextNumber Int     @default(1)

  legalTextTranslations   Json?
  footerTextTranslations  Json?
  bankDetails             Json?

  isActive                Boolean       @default(true)

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────
// QUOTATION (DEVIS)
// ─────────────────────────────────────────
//
// One quotation per order (unique on orderId). The full lifecycle:
//
//   draft → admin edits fees, language, notes
//   sent → admin transitioned status; order.status becomes quotation_sent
//   approved → doctor approved; order.status becomes fabrication
//   rejected → doctor rejected; order.status becomes canceled
//   canceled → admin canceled (e.g. before sending, or to re-issue)
//
// `companySnapshot` (JSONB) and `clinicSnapshot` (JSONB) lock in the
// data used to render the PDF at the time it was generated/sent — old
// quotes remain historically correct even if the admin edits
// CompanyBillingSettings or the doctor edits their DentistProfile later.
//
// Money fields use Float to match the rest of the project. Calculation
// is centralized in QuotationService.computeTotals() and rounded to
// three decimal places at the boundary (TND uses 3-decimal pricing).
model Quotation {
  id                  String           @id @default(uuid())
  orderId             String           @unique
  // DEV-000001 style, unique across the system. Assigned in a tx when
  // the quote first transitions out of draft (or when its PDF is
  // generated, whichever comes first).
  quotationNumber     String?          @unique

  language            DevisLanguage    @default(fr)
  status              QuotationStatus  @default(draft)

  // Fees (admin-entered, doctor sees but cannot edit)
  treatmentFees       Float            @default(0)
  fabricationFees     Float            @default(0)
  deliveryFees        Float            @default(0)
  discountAmount      Float            @default(0)

  // Calculated and persisted so PDFs / summaries don't recompute every read.
  // Always derived from the fees above by computeTotals().
  subTotalHt          Float            @default(0)
  tvaRate             Float            @default(19)
  tvaAmount           Float            @default(0)
  totalTtc            Float            @default(0)
  currency            String           @default("TND")

  notes               String?
  // Optional admin-only message rendered above the totals block. Useful
  // for explaining a discount or attached terms.
  adminMessage        String?

  // Snapshots — see header comment.
  companySnapshot     Json?
  clinicSnapshot      Json?

  // Relative path under uploads/, never an absolute URL.
  pdfFilePath         String?

  sentAt              DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?

  createdById         String?
  createdByName       String?          // actor snapshot (survives account deletion)
  approvedById        String?
  rejectedById        String?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  // ── Pack snapshot (added in 20260524 — packs/payments rollout) ───
  // Stored at attach-pack time so a later pack/price edit can never
  // mutate an already-issued quote. Legacy quotes leave these null
  // and continue rendering against the Float totalTtc above.
  packId                 String?
  pack                   Pack?            @relation(fields: [packId], references: [id], onDelete: SetNull)
  packName               String?
  archType               ArchType?
  maxStepsPerArch        Int?
  includedCorrections    Int?
  isUnlimitedSteps       Boolean          @default(false)
  isUnlimitedCorrections Boolean          @default(false)
  isForOrthodontists     Boolean          @default(false)

  // ── Money (Decimal — new canonical) ─────────────────────────────
  // Distinct from the legacy Float `totalTtc` so the PDF generator
  // + existing UI keep working untouched. At pack-quote creation we
  // copy `totalTtc` into `totalPrice` (rounded to 3dp). `paidAmount`
  // is recalculated from successful Payments only — never trust the
  // client.
  totalPrice            Decimal?          @db.Decimal(12, 3)
  paidAmount            Decimal           @default(0) @db.Decimal(12, 3)
  remainingAmount       Decimal?          @db.Decimal(12, 3)

  // ── Loyalty discount snapshot ───────────────────────────────────
  // Set once when a pack is attached, from the doctor's loyalty tier
  // earned in the PREVIOUS quarter. Frozen on the quote — the amount
  // also feeds the legacy discountAmount so the PDF shows the line —
  // so later rule changes never rewrite an issued devis (same idiom
  // as the pack snapshot above).
  loyaltyDiscountPercent Decimal?         @db.Decimal(5, 2)
  loyaltyDiscountAmount  Decimal?         @db.Decimal(12, 3)

  // ── Payment plan + status ───────────────────────────────────────
  paymentMode           PaymentMode?
  paymentStatus         QuotationPaymentStatus @default(pending)
  doctorApprovedAt      DateTime?

  // DELETION POLICY: Restrict — a numbered devis (gapless DEV- counter)
  // must never disappear through an order hard-delete; the order can only
  // be purged while no quotation exists. Admin "cancel" of a draft/sent
  // quote is an explicit, payment-guarded hard delete (see
  // QuotationService.cancel).
  order               DentalOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy           User?            @relation("QuotationCreatedBy",  fields: [createdById],  references: [id], onDelete: SetNull)
  approvedBy          User?            @relation("QuotationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy          User?            @relation("QuotationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  installments         QuoteInstallment[]
  stepBatches          QuoteStepBatch[]
  payments             Payment[]

  @@index([orderId])
  @@index([status])
  @@index([language])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([packId])
  @@index([paymentStatus])
}

// ─────────────────────────────────────────
// PACK CATALOGUE
// ─────────────────────────────────────────
// Commercial offerings the admin manages. Quotations snapshot the
// chosen pack so editing the catalogue never rewrites history. Active
// flag + soft-delete (deletedAt) gate pack visibility for new quotes.

model Pack {
  id                       String      @id @default(uuid())
  // `name` / `description` stay as the FRENCH fallback + backward-compat
  // columns (older packs and any non-i18n reader keep working). The
  // localized bags below are the source of truth for display; the
  // service always mirrors the FR value into these plain columns.
  name                     String
  description              String?

  // Localized content bags — Localized<string> = { fr, en? }. Stored as
  // Json (same pattern the Blog model uses) so no per-language columns.
  // Null on legacy rows → the UI falls back to `name` / `description`.
  nameI18n                 Json?
  descriptionI18n          Json?
  // Table-style multilingual labels. No legacy plain-string counterpart
  // (these fields are new), so they live only as localized bags.
  treatmentExpirationLabel Json?       // Localized<string>
  finishingIncludedLabel   Json?       // Localized<string>

  // null + the matching unlimited flag = pack covers unlimited steps /
  // corrections. The two boolean flags are the source of truth — the
  // numeric fields are NULL when unlimited. `maxStepsPerArch` doubles as
  // the "number of aligners per arch" business field.
  maxStepsPerArch          Int?
  includedCorrections      Int?
  isUnlimitedSteps         Boolean     @default(false)
  isUnlimitedCorrections   Boolean     @default(false)
  isForOrthodontists       Boolean     @default(false)
  isActive                 Boolean     @default(true)

  deletedAt                DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  prices                   PackPrice[]
  quotations               Quotation[]

  @@index([isActive, deletedAt])
  @@index([name])
}

// One row per (pack, archType) combination. A pack can carry multiple
// archived prices over time — `isActive=false` ones are kept for
// snapshot integrity but excluded from new-quote selection. The
// `@@unique([packId, archType, isActive])` constraint enforces "at
// most one active price per (pack, arch)" at the database layer.
model PackPrice {
  id        String   @id @default(uuid())
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  archType  ArchType
  price     Decimal  @db.Decimal(12, 3)
  currency  String   @default("TND")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packId, archType, isActive])
  @@index([packId])
}

// ─────────────────────────────────────────
// LOYALTY PROGRAM
// ─────────────────────────────────────────
// Quarterly practitioner loyalty (grille 2026): N approved treatments
// during a quarter earn a percentage discount on every pack quote of
// the FOLLOWING quarter. Tiers are admin-editable rows (variable
// count — same idiom as PackPrice rather than fixed settings
// columns); closed quarters are persisted per doctor with the awarded
// percent SNAPSHOTTED, so future tier edits never rewrite history.

model LoyaltyTier {
  id              String   @id @default(uuid())
  // Treatments required within one quarter to reach this tier.
  minTreatments   Int
  // Discount granted on the following quarter's pack quotes (0-100).
  discountPercent Decimal  @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, minTreatments])
}

model LoyaltyQuarterResult {
  id              String   @id @default(uuid())
  doctorId        String
  // Calendar quarter the TREATMENTS were counted in (UTC). The awarded
  // discount applies to the quarter that FOLLOWS this one.
  year            Int
  quarter         Int      // 1..4
  treatmentCount  Int
  // Snapshot of the highest tier reached when the quarter was closed.
  // Zero when no tier was reached. Kept as literal values (not a tier
  // FK) so deleting or editing tiers never mutates a closed quarter.
  tierMinTreatments Int?
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  computedAt      DateTime @default(now())

  // DELETION POLICY: Restrict — a closed quarter is a financial record
  // backing discounts on issued quotes; purge the results explicitly
  // before ever hard-deleting a practitioner.
  doctor          User     @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([doctorId, year, quarter])
  @@index([year, quarter])
}

// ─────────────────────────────────────────
// INSTALLMENTS + STEP BATCHES
// ─────────────────────────────────────────
// One installment per scheduled payment. `availableFrom` gates when
// the doctor can start a payment; `dueDate` is informational (overdue
// derivation lives in the service). Each installment is linked 1:1
// to a step batch — the batch holds the from/to-step range that
// unlocks when the installment is paid.

model QuoteInstallment {
  id                String                @id @default(uuid())
  quotationId       String
  quotation         Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount            Decimal               @db.Decimal(12, 3)
  availableFrom     DateTime
  dueDate           DateTime?
  status            InstallmentStatus     @default(pending)
  paidAt            DateTime?

  stepBatch         QuoteStepBatch?
  payments          Payment[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([quotationId, installmentNumber])
  @@index([status])
}

// The "delivery schedule" half of the system. Steps cover a contiguous
// range `[fromStep, toStep]` of the aligner protocol. Multiple batches
// on a quote MUST cover disjoint ranges — enforced in the service.
// Status transitions: locked → unlocked (auto, on installment paid) →
// delivered (manual, admin only). Locked batches CAN NEVER be
// delivered — that invariant is enforced inside the deliver service.
model QuoteStepBatch {
  id             String           @id @default(uuid())
  quotationId    String
  quotation      Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  installmentId  String           @unique
  installment    QuoteInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  batchNumber    Int
  fromStep       Int
  toStep         Int
  status         BatchStatus      @default(locked)

  unlockedAt     DateTime?
  deliveredAt    DateTime?
  deliveredById  String?
  deliveredBy    User?            @relation("BatchDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([quotationId, batchNumber])
  @@index([status])
}

// ─────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────
// One row per payment attempt regardless of method. The service's
// `handleSuccess()` is the SINGLE transition path that flips a
// payment to `success`, marks its installment paid, and unlocks the
// linked batch — all inside one transaction with FOR UPDATE on the
// installment row. CARD goes pending→success via the gateway,
// BANK_TRANSFER goes awaiting_confirmation→success via admin
// confirm, CASH is admin-recorded straight to success.

model Payment {
  id              String              @id @default(uuid())

  // DELETION POLICY: the ledger. Nothing may cascade into Payment:
  //   • order / quotation → Restrict (a parent with payments cannot be
  //     hard-deleted; soft-delete only)
  //   • installment → SetNull (optional): an admin may legitimately
  //     re-plan installments while only failed/cancelled attempts exist;
  //     those attempts keep their order + quotation link and amount.
  orderId         String
  order           DentalOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quotationId     String
  quotation       Quotation           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  installmentId   String?
  installment     QuoteInstallment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  // Amount is COPIED from the installment at payment-creation time
  // and never trusted from the client. Stored here so the audit row
  // is self-contained even if the installment is later edited (only
  // possible before approval).
  amount          Decimal             @db.Decimal(12, 3)

  // Sequential receipt/invoice number (e.g. FAC-000001), allocated
  // lazily the first time a successful payment's receipt is rendered.
  // Null for pending/legacy rows. Admin can override it; unique so two
  // receipts never print the same number.
  invoiceNumber   String?             @unique
  // Invoice row generated automatically when this payment succeeded.
  // The receipt PDF and this invoice deliberately share invoiceNumber:
  // one payment, one document number.
  invoice         Invoice?            @relation("PaymentInvoice")

  status          PaymentRecordStatus
  paymentMethod   PaymentMethod

  // CARD: gateway tx id. BANK_TRANSFER: bank reference (optional).
  // CASH: receipt number (optional). Stored as text so we don't
  // commit to a particular gateway's id format.
  transactionId   String?

  // Idempotency key for CARD callbacks. Unique so the second delivery
  // of the same webhook hits a constraint violation (caught at the
  // service layer and translated to an idempotent 200 OK).
  idempotencyKey  String?             @unique

  // BANK_TRANSFER: relative path under /uploads/payments/<id>/proof.<ext>.
  proofUrl        String?
  // Admin notes when confirming / rejecting manual payments.
  notes           String?

  declaredAt      DateTime?  // BANK_TRANSFER doctor declaration time
  paidAt          DateTime?  // when money is considered received
  confirmedAt     DateTime?  // admin confirmation timestamp
  confirmedById   String?
  confirmedBy     User?               @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?               @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  initiatedById   String?
  initiatedBy     User?               @relation("PaymentInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([quotationId])
  @@index([installmentId])
  @@index([status])
  @@index([paymentMethod])
  // Added 2026-05-25 for the payment-history filter UI at scale.
  //  • (status, createdAt DESC)   — admin queue narrowing + default sort
  //  • (paymentMethod, status)    — method-filtered queries
  //  • (orderId, createdAt DESC)  — doctor-scoped history with sort
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentMethod, status])
  @@index([orderId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────
//
// In-app notification ledger. Every event in the system that the user
// should know about (a quote was sent, a payment was confirmed, an order
// changed status, …) writes one row here keyed to the recipient's
// userId. The frontend polls the unread count + recent rows from
// /api/notifications, and the user marks them read on click.
//
// Why a single table for both roles:
//   • Each notification has exactly one recipient, regardless of role
//   • Admin-targeted events (e.g. "new payment to confirm") simply
//     create one row per admin user — same shape, same lifecycle, no
//     special "broadcast" column to keep in sync.
// The `type` enum is intentionally flat (no "audience" field): the
// listener that produces the row already knows whether it should be
// reaching an admin or a doctor.

enum NotificationType {
  // ── Admin-facing ─────────────────────────────────────────────
  user_registered          // new user signed up, awaiting approval
  order_created            // doctor created an order
  order_submitted          // doctor submitted an order for review
  payment_received         // a doctor card-paid an installment
  payment_declared         // a doctor declared a bank transfer
  cash_payment_recorded    // admin colleague recorded a cash payment
  treatment_fee_declared   // doctor uploaded a bank-transfer receipt for the treatment fee → admin needs to confirm
  treatment_fee_paid       // doctor settled the treatment fee instantly (card) OR an admin recorded cash
  // ── Doctor-facing ────────────────────────────────────────────
  order_status_changed     // admin moved the order along the lifecycle
  treatment_plan_ready     // planner marked the treatment plan ready
  treatment_plan_updated   // planner edited the plan after sending it
  quotation_sent           // admin sent the quote to the doctor
  quotation_canceled       // admin canceled a sent quote
  quotation_recalled       // admin pulled a sent quote back to draft for correction
  payment_confirmed        // admin confirmed a bank/cash payment
  payment_rejected         // admin rejected a bank transfer proof
  treatment_fee_confirmed  // admin confirmed the doctor's treatment-fee bank transfer → treatment plan can now start
  batch_unlocked           // a step batch moved from locked → unlocked
  batch_delivered          // admin marked a step batch as delivered
  installment_overdue      // an installment passed its due date unpaid
  // ── Generic ──────────────────────────────────────────────────
  system_message
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  type        NotificationType
  title       String           // short human-readable headline
  message     String           // one-line body shown in the dropdown
  /// Deep link the UI uses on click. Path-only (e.g.
  /// `/dashboard/orders/abc?tab=quote`), never an absolute URL.
  link        String?
  /// Structured payload for rich previews / future filters. JSON shape
  /// is owned by the emitting listener — never read it as authoritative
  /// state, always re-fetch from the real resource.
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Hot path: "list the unread ones for this user, newest first" — the
  // composite index serves both filters in one scan.
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// ─────────────────────────────────────────
// SUPPORT CHAT
//
// Direct doctor↔admin messaging with image attachments. Conversations
// are scoped per-doctor; doctors can open multiple threads (one per
// topic) and admins manage every active thread from /dashboard/support.
//
// Lifecycle: open → pending → resolved → closed. Soft-delete is the
// terminal state, admin-only.
//
// Per-message read receipts (`readAt`) PLUS aggregate `unreadBy*`
// counters on the conversation — the counters back the bell badge
// without scanning every message on every fetch.
// ─────────────────────────────────────────

enum SupportConversationStatus {
  open       // active thread waiting on admin or doctor reply
  pending    // admin is investigating but no immediate action
  resolved   // admin has handled; doctor can re-open by replying
  closed     // terminal; no further messages accepted
}

enum SupportPriority {
  low
  normal
  high
  urgent
}

model SupportConversation {
  id              String                     @id @default(uuid())
  doctorId        String
  doctor          User                       @relation("SupportConvDoctor", fields: [doctorId], references: [id], onDelete: Cascade)

  // Optional one-line topic shown in the admin list. Doctors don't
  // have to provide one — falls back to the first message preview.
  subject         String?

  status          SupportConversationStatus  @default(open)
  priority        SupportPriority            @default(normal)

  // Optional admin who took ownership. Cleared when the admin user is
  // deleted (SetNull) so the conversation doesn't orphan.
  assignedAdminId String?
  assignedAdmin   User?                      @relation("SupportConvAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  // Aggregate unread counters — incremented by the WRITE path and
  // reset to 0 by the READ path (mark-as-read). Cheap to query from
  // the admin queue and from the doctor's bubble badge.
  unreadByAdmin   Int                        @default(0)
  unreadByDoctor  Int                        @default(0)

  // Surface the most-recent message metadata for the conversation
  // list rendering — saves a join + sub-query on every page load.
  lastMessageAt   DateTime                   @default(now())
  lastMessagePreview String?                 // first ~120 chars of the latest body

  resolvedAt      DateTime?
  closedAt        DateTime?

  deletedAt       DateTime?                  // admin-only soft delete
  deletedById     String?

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  messages        SupportMessage[]

  // Hot paths:
  //  • doctor side: "my open conversations, newest first"
  //  • admin queue: "every conversation, sorted by lastMessageAt DESC,
  //    optionally narrowed by status"
  //  • trash view: "deletedAt IS NOT NULL, newest first"
  @@index([doctorId, deletedAt, lastMessageAt(sort: Desc)])
  @@index([status, deletedAt, lastMessageAt(sort: Desc)])
  @@index([assignedAdminId])
  @@index([deletedAt])
}

model SupportMessage {
  id              String                @id @default(uuid())
  conversationId  String
  conversation    SupportConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Actor ref: SetNull so deleting an admin account does not punch holes
  // in doctors' support threads. senderName + senderRole are snapshots.
  senderId        String?
  sender          User?                 @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName      String?
  // Snapshot of the sender's role at write-time. Cheaper than a join
  // on every render and keeps the bubble for legacy users intact
  // even if the user's role changes later.
  senderRole      UserRole

  // Text body. Optional — a message can be image-only.
  body            String?

  // ONE attachment per message keeps the schema simple. A doctor who
  // wants to attach 3 screenshots sends 3 consecutive messages, which
  // also gives the admin a clearer thread.
  attachmentRelativePath String?         // path under /uploads/support/<convId>/...
  attachmentMime         String?
  attachmentName         String?         // original filename (display only)
  attachmentSize         Int?            // bytes
  // Variant map written by the async media pipeline for image
  // attachments (same shape as OrderFile.variants). Best-effort: null
  // simply means "serve the original".
  attachmentVariants     Json?

  // Per-message read receipt — the recipient's read time. Updated
  // when the recipient calls mark-as-read on the conversation.
  readAt          DateTime?

  // Soft delete (admin only — for moderation). Not exposed to doctors.
  deletedAt       DateTime?

  createdAt       DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, readAt])
}

// ─────────────────────────────────────────────────────────────────────
// Doctor-dashboard slider media (admin-managed)
// ─────────────────────────────────────────────────────────────────────
//
// Admins curate a rotating gallery of images + short videos that the
// doctor dashboard renders above the available-packs section. Two
// independent lists — desktop vs mobile — so the admin can ship
// different aspect ratios per device without coupling counts.
//
// A single row can be flagged `both` (deviceTargets contains BOTH
// DESKTOP and MOBILE) when the same asset works on every viewport —
// in that case we render it on both surfaces but keep the row count
// down. Most rows will target a single device.
//
// Source can be a local upload (uploaded to /uploads/slider/...) or
// an external URL (CDN, S3, YouTube/Vimeo for videos). External
// links bypass our disk quota and are useful for high-traffic CDNs.

enum SliderMediaType {
  image
  video
}

enum SliderMediaSourceType {
  upload
  external
}

enum SliderMediaDeviceTarget {
  desktop
  mobile
}

enum SliderMediaStatus {
  active
  inactive
}

model SliderMedia {
  id          String                    @id @default(uuid())

  // Short human-readable label shown in the admin table and used as
  // the slide's alt-text on the doctor dashboard. Required so the
  // admin always knows what they uploaded a week from now.
  title       String

  // image | video — drives the renderer on the doctor side (<img> vs
  // <video autoplay muted loop playsinline>) and the file-type guard
  // on upload.
  mediaType   SliderMediaType

  // upload (multipart file → /uploads/slider) vs external (admin
  // pastes a CDN URL). When upload, *Url fields point at our static
  // server; when external, they hold the absolute CDN URL.
  sourceType  SliderMediaSourceType

  // Resolved URL the doctor browser will load. We snapshot one URL
  // per device so the admin can ship a wide hero on desktop and a
  // tall portrait on mobile from the same logical "slide". Either
  // can be null — if `desktopUrl` is set and `mobileUrl` is null and
  // the row targets BOTH devices, the doctor mobile dashboard
  // gracefully falls back to the desktop URL.
  desktopUrl  String?
  mobileUrl   String?

  // Variant maps written by the async media pipeline for UPLOADED
  // images only (external CDN URLs and videos are never processed).
  // Same shape as OrderFile.variants; paths resolve under /uploads/.
  // Null = serve the original URL.
  desktopVariants Json?
  mobileVariants  Json?

  // Which device list this row belongs to. Stored as a postgres
  // array so the admin can pick desktop / mobile / both with one
  // checkbox group. The composite index below uses an array-contains
  // filter so listing "desktop slides" stays cheap at 100k rows.
  deviceTargets SliderMediaDeviceTarget[]

  // Lifecycle flag — `inactive` rows are hidden from the doctor
  // dashboard but kept in the admin table for re-activation later.
  // Soft delete (deletedAt) is the harder kill.
  status      SliderMediaStatus         @default(active)

  // Manual ordering — admin drags rows to set the carousel order.
  // We use an integer (not a fractional rank) because reordering
  // happens rarely; a full re-write on save is cheap at gallery
  // sizes (< 100 rows realistic, but the index covers 100k+).
  displayOrder Int                      @default(0)

  // Optional UTC link target — clicking the slide opens this URL in
  // a new tab. Used to point at a pack page, a support article, etc.
  linkUrl     String?

  // Admin who last touched the row. Useful for audit + "who broke
  // the slider" questions. SetNull on user delete so the row
  // doesn't orphan.
  createdById String?
  createdBy   User?                     @relation("SliderMediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  // Hot paths:
  //   • doctor dashboard "active slides for this device, ordered":
  //     status=active AND deletedAt IS NULL AND deviceTargets @> {desktop|mobile}
  //   • admin list with filter chips: status, deviceTargets, deletedAt
  @@index([status, deletedAt, displayOrder])
  @@index([deletedAt, displayOrder])
}

// ─────────────────────────────────────────
// PRACTITIONER BLOG
// ─────────────────────────────────────────
//
// A small CMS for the marketing/showcase blog. An admin authors posts
// in the dashboard; the public showcase reads only `published`,
// non-deleted posts. The body is a JSON array of typed content blocks
// (heading / paragraph / image / gallery / video / quote / cta /
// divider) — flexible enough to lay out a rich article without a
// separate block table, and the renderer switches exhaustively over
// the block `type`.

// Lifecycle of a blog post. Mirrors the lowercase Prisma-enum style
// used elsewhere; the frontend enum carries identical string values.
enum BlogStatus {
  draft
  published
  archived
}

// Which showcase audience a post targets. The public showcase has two
// distinct surfaces (a patient-facing blog and a practitioner-facing
// blog); a post belongs to exactly one. The frontend enum carries
// identical lowercase string values.
enum BlogAudience {
  patient
  practitioner
}

// One image in the blog media library. Uploaded via the admin image
// endpoint; the async media pipeline ('blog-image' job) fills width/
// height + resized `variants`. `url` is ALWAYS a relative
// `/uploads/blog/<uuid>.ext` path — the DTO mapper builds relative
// variant URLs from it and NEVER exposes a raw disk path.
model BlogImage {
  id               String                 @id @default(uuid())

  // The client-supplied filename (audit only) + the on-disk UUID name.
  originalName     String?
  generatedName    String?

  // Relative static URL the frontend resolves to an absolute origin.
  url              String

  // Default alt text suggested at upload time; per-block alt overrides
  // it in the content blocks.
  alt              String?

  mimeType         String?
  sizeBytes        Int?

  // Intrinsic pixel size of the ORIGINAL (filled by the pipeline).
  width            Int?
  height           Int?

  // ── Media-optimization pipeline (same contract as OrderFile) ──────
  processingStatus MediaProcessingStatus?
  // Variant map: { thumb|md|lg|avif: { path, width?, height?, sizeBytes,
  // format } }. Paths are uploads-root-relative, never exposed raw.
  variants         Json?
  mediaMetadata    Json?
  processedAt      DateTime?

  // Admin who uploaded the image. SetNull on user delete so the image
  // (and any post referencing it) survives the author being removed.
  createdById      String?
  createdBy        User?                  @relation("BlogImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Back-relation for Blog.coverImage. Prisma requires both ends of a
  // named relation to be declared; no foreign key lives here (the FK is
  // on Blog.coverImageId), so this is purely a virtual back-reference.
  blogCovers       Blog[]                 @relation("BlogCover")

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  @@index([processingStatus])
  @@index([deletedAt])
}

model Blog {
  id             String      @id @default(uuid())

  // ── Bilingual content (v2) ───────────────────────────────────────
  // Every reader-facing text field is a Localized<T> JSON bag —
  // `{ en, fr }` — so a single post carries both languages and the
  // client/CMS picks one at render time. The service enforces that at
  // least one language of `title` is non-empty on create; the read
  // mappers defensively coerce a legacy plain string `s` → `{en:s,fr:s}`.
  title          Json        // Localized<string>
  // URL slug — unique across all posts. Derived from (title.fr ||
  // title.en) when the admin doesn't supply one; collisions get a
  // -2/-3/… suffix.
  slug           String      @unique
  // Short summary for cards + SEO description fallback. Per language;
  // a blank language is derived from that language's first paragraph.
  excerpt        Json?       // Localized<string>

  // Per-language ordered arrays of typed content blocks (see BlogBlock
  // in the DTOs): { en: BlogBlock[]; fr: BlogBlock[] }. Image/gallery
  // blocks in BOTH languages may reference the same shared BlogImage.
  content        Json?       // { en: BlogBlock[]; fr: BlogBlock[] }

  // Which showcase surface this post targets (patient vs practitioner).
  // Required on create; defaults keep legacy/partial rows valid.
  audience       BlogAudience @default(practitioner)

  // Lifetime public view count — best-effort incremented on each public
  // detail render via POST /blog/:slug/view.
  views          Int          @default(0)

  // Optional cover image (from the BlogImage library). SetNull so
  // deleting the image doesn't take the post down — it just loses its
  // cover. Images are shared across both languages.
  coverImageId   String?
  coverImage     BlogImage?  @relation("BlogCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  coverImageAlt  Json?       // Localized<string>

  // Free-text category used by the showcase filter + "related posts".
  category       String?

  // Author. SetNull on user delete; `authorName` is snapshotted at
  // create time so the byline survives even after the account is gone.
  authorId       String?
  author         User?       @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?

  status         BlogStatus  @default(draft)

  // SEO overrides — per language; fall back to title/excerpt when blank.
  seoTitle       Json?       // Localized<string>
  seoDescription Json?       // Localized<string>
  seoKeywords    Json?       // Localized<string[]>

  // Derived per language: ceil(words / 200), min 1.
  readingTime    Json?       // Localized<number>

  // Set once when the post first becomes `published`; left intact
  // thereafter so the public ordering (newest published first) is
  // stable across unpublish/republish cycles.
  publishedAt    DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  // Hot paths:
  //   • public list: audience=X AND status=published AND deletedAt IS
  //     NULL, newest publishedAt first (covered by the composite index).
  //   • slug lookup, category filter, author filter, soft-delete scan.
  //   • admin status-narrowed list (kept from v1).
  @@index([audience, status, deletedAt, publishedAt(sort: Desc)])
  @@index([slug])
  @@index([category])
  @@index([authorId])
  @@index([deletedAt])
  @@index([status, deletedAt, publishedAt(sort: Desc)])
}

// ─────────────────────────────────────────
// PUBLIC COMMUNITY SUBMISSIONS
// ─────────────────────────────────────────

enum CommunitySubmissionFormat {
  video
  photo
  text
}

enum CommunitySubmissionRole {
  adult
  parent
  teen
}

enum CommunitySubmissionTreatmentStatus {
  in_progress
  completed
}

enum CommunitySubmissionStatus {
  pending
  approved
  rejected
}

model CommunitySubmission {
  id                String                              @id @default(uuid())
  format            CommunitySubmissionFormat
  status            CommunitySubmissionStatus           @default(pending)

  firstName         String                              @db.VarChar(80)
  lastNameInitial   String                              @db.VarChar(2)
  phone             String                              @db.VarChar(32)
  email             String                              @db.VarChar(254)
  city              String?                             @db.VarChar(120)
  role              CommunitySubmissionRole
  childName         String?                             @db.VarChar(80)
  childAge          Int?
  treatmentStatus   CommunitySubmissionTreatmentStatus

  why               String                              @db.Text
  journey           String                              @db.Text
  satisfied         String?                             @db.Text
  message           String?                             @db.Text
  consent           Boolean
  contactConsent    Boolean                             @default(false)

  reviewNote        String?                             @db.Text
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?                               @relation("CommunitySubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  media             CommunitySubmissionMedia[]

  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([reviewedById])
}

model CommunitySubmissionMedia {
  id             String              @id @default(uuid())
  submissionId   String
  submission     CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  relativePath   String
  originalName   String?             @db.VarChar(255)
  mimeType       String              @db.VarChar(100)
  sizeBytes      Int
  width          Int?
  height         Int?
  durationSeconds Float?
  createdAt      DateTime            @default(now())

  @@index([submissionId])
}

// ─────────────────────────────────────────────────────────────────────
// Manual / admin invoicing
//
// The two ORIGINAL invoice flows stay exactly as they were: a receipt for
// a Payment and the treatment-fee invoice for a DentalOrder are still
// computed on the fly, and neither is touched by these models.
//
// What they could NOT express is what the admin desk actually needs:
//   • an invoice for a walk-in client with no order and no quotation
//     (Payment.orderId / .quotationId are NOT NULL),
//   • free line items (Payment carries a single scalar `amount`),
//   • an editable status, notes and a billing address,
//   • a trace of who changed an invoice after it was issued.
//
// So: one record, its lines, and an audit trail. Everything else — the
// PDF template, the FAC-xxxxxx counter, the company header — is reused.
// ─────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  draft      // editable freely, no number consumed yet in spirit
  issued     // sent to the client
  paid       // settled
  cancelled  // voided, kept for the sequence's continuity
}

model Invoice {
  id             String        @id @default(uuid())
  // Allocated from CompanyBillingSettings.invoicePrefix/invoiceNextNumber,
  // the same counter the payment receipts use, so a single sequence covers
  // every document the company issues.
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(draft)

  // ── Optional links to existing business rows ──────────────────────
  // All three are OPTIONAL: a manual invoice may have none of them. They
  // are Restrict/SetNull, never Cascade — an invoice is a financial
  // document and must outlive the rows it references (see DELETION-POLICY).
  orderId        String?
  order          DentalOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Payment this invoice was generated FROM, for the automatic flow.
  // @unique is what makes generation idempotent: a replayed gateway
  // callback, a double click on "confirm", or a retried listener can
  // never mint a second invoice for the same payment.
  // SetNull, never Cascade — an invoice outlives everything it points at.
  paymentId      String?       @unique
  payment        Payment?      @relation("PaymentInvoice", fields: [paymentId], references: [id], onDelete: SetNull)
  patientId      String?
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId       String?
  doctor         User?         @relation("InvoiceDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  // ── Client block (always a snapshot) ──────────────────────────────
  // Copied from the patient/doctor when one was picked, typed by hand
  // otherwise. Snapshotted either way so editing a patient later never
  // rewrites an invoice that has already been issued.
  clientName     String
  clientEmail    String?
  clientPhone    String?
  clientAddress  String?
  clientCity     String?
  clientCountry  String?
  clientTaxId    String?       // matricule fiscal of the client

  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  currency       String        @default("TND")

  // ── Money. Decimal(12,3) like the rest of the ledger (TND has 3
  // decimals). Every one of these is COMPUTED SERVER-SIDE from the
  // lines — the frontend never gets to post a total.
  tvaRate        Float         @default(19)
  discountAmount Decimal       @default(0) @db.Decimal(12, 3)
  // Snapshotted, not read live at render time: changing the company's
  // stamp duty must not silently rewrite invoices already issued.
  stampDuty      Decimal       @default(0) @db.Decimal(12, 3)
  subTotalHt     Decimal       @default(0) @db.Decimal(12, 3)
  tvaAmount      Decimal       @default(0) @db.Decimal(12, 3)
  totalTtc       Decimal       @default(0) @db.Decimal(12, 3)

  notes          String?
  language       String        @default("fr") // 'fr' | 'en', drives the PDF
  // Company header frozen at issue time, same idea as Quotation.companySnapshot.
  companySnapshot Json?

  createdById    String?
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName  String?

  issuedAt       DateTime?
  paidAt         DateTime?
  deletedAt      DateTime?     // archive; a financial document is never hard-deleted casually
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines          InvoiceLine[]
  auditLogs      InvoiceAuditLog[]

  // Hot paths: the admin list (status + date), the search by number,
  // and the per-client / per-order lookups.
  @@index([status, deletedAt, issueDate(sort: Desc)])
  @@index([issueDate(sort: Desc)])
  @@index([orderId])
  @@index([patientId])
  @@index([doctorId])
  @@index([deletedAt])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  // Cascade is correct here and only here: a line has no meaning without
  // its invoice, and the invoice itself is Restrict-protected upstream.
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position    Int      @default(0) // display order, 0-based
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 3)
  // Per-line VAT override. NULL means "use the invoice rate" — which is
  // the normal case, so a simple invoice stays simple.
  tvaRate     Float?
  // Persisted so the stored total can be re-derived and audited without
  // recomputing from scratch. Always written by the server.
  lineHt      Decimal  @default(0) @db.Decimal(12, 3)

  createdAt   DateTime @default(now())

  @@index([invoiceId, position])
}

model InvoiceAuditLog {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Actor ref: SetNull + name snapshot, the pattern every other audit
  // column in this schema uses.
  actorId   String?
  actor     User?    @relation("InvoiceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?

  action    String   // 'updated' | 'status_changed' | 'lines_changed' | …
  // { field: { from, to } } — only the fields that actually moved.
  changes   Json?

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([actorId])
}
