# Force LF line endings for files that run on Linux (the VPS) so
# Windows checkouts don't break the deploy pipeline.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf

# Keep everything else as-is.
*           text=auto

# Self-hosted web fonts (oralign-frontend/src/fonts): never touch the bytes.
*.woff2     binary
