# Database
DATABASE_URL="postgresql://user:password@localhost:5432/oralign_db"

# Server
HTTP_PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_RESET_SECRET="your-super-secret-reset-key-change-in-production"
JWT_EXPIRATION=900 # 15 minutes in seconds
JWT_REFRESH_EXPIRATION=604800 # 7 days in seconds

# Email Configuration (for password reset and verification)
#
# DELIVERABILITY — read before changing MAIL_FROM:
# The From address domain MUST be authenticated for the SMTP provider you
# send through (SPF + DKIM), or DMARC alignment fails and mail goes to
# spam. Concretely:
#   • Gmail SMTP  → MAIL_FROM must be the SAME address as MAIL_USER
#                   (or a Gmail-verified alias). Never a custom domain.
#   • Custom domain (no-reply@oralign.com.tn) → use a transactional
#     provider (Brevo / Mailgun / SMTP2GO / Resend / Google Workspace)
#     and publish the SPF + DKIM + DMARC DNS records it gives you.
# Leave MAIL_FROM unset to default to MAIL_USER (always aligned).
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="your-email@gmail.com"
MAIL_FROM_NAME="Oralign"
# Optional: where replies should land (defaults to MAIL_FROM)
# MAIL_REPLY_TO="contact@oralign.com.tn"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"
