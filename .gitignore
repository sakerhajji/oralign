# ─── Environment ────────────────────────────────────────────────
# Never commit real secrets. Only the *.example files ship.
.env
.env.*
!.env.example
!.env.production.example
!.env.docker.example

# ─── Dependencies ───────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ─── Build output ───────────────────────────────────────────────
.next/
**/.next/
dist/
**/dist/
build/
**/build/
out/
**/out/
*.tsbuildinfo

# ─── Runtime data ───────────────────────────────────────────────
uploads/
**/uploads/
*.log
logs/
.deploy.previous

# ─── Coverage / tests ───────────────────────────────────────────
coverage/
*.lcov

# ─── IDE / OS ───────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude / agent metadata ────────────────────────────────────
.claude/

# ─── Local asset source (not used at runtime) ───────────────────
# Raw tooth SVGs lived in `teeths/` before they were extracted into
# the runtime sprite at `oralign-frontend/public/teeth-sprite.svg`.
# The sprite IS tracked; the raw source folder isn't.
teeths/

# ─── Misc ───────────────────────────────────────────────────────
.turbo/
.cache/
*.tgz
*.tar.gz

# ─── Archives (one-off downloads, e.g. WeTransfer asset drops) ──
# These are sources for assets/photos that get processed into the
# runtime tree separately. The archive itself never needs to be in
# git — keeping it out also avoids bloating the repo with 10+ MB
# binaries.
*.zip
*.rar
*.7z
